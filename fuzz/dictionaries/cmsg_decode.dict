# Control-message headers for the Linux layout: an 8-byte length, a level and a type.
len_header="\x10\x00\x00\x00\x00\x00\x00\x00"
len_int="\x14\x00\x00\x00\x00\x00\x00\x00"
len_pktinfo="\x1c\x00\x00\x00\x00\x00\x00\x00"
len_huge="\xff\xff\xff\xff\xff\xff\xff\xff"
level_ip="\x00\x00\x00\x00"
level_socket="\x01\x00\x00\x00"
level_udp="\x11\x00\x00\x00"
level_ipv6="\x29\x00\x00\x00"
type_tos="\x01\x00\x00\x00"
type_pktinfo="\x08\x00\x00\x00"
type_gro="\x68\x00\x00\x00"
type_segment="\x67\x00\x00\x00"
loopback="\x7f\x00\x00\x01"
