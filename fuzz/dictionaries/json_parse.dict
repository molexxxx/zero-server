# JSON structural characters, literals, escapes and number parts.
lbrace="{"
rbrace="}"
lbracket="["
rbracket="]"
colon=":"
comma=","
quote="\""
true="true"
false="false"
null="null"
esc_u="\\u"
esc_high="\\ud834"
esc_low="\\udd1e"
esc_lone="\\udc00"
esc_n="\\n"
esc_bad="\\x"
exp="e+10"
frac=".5"
minus="-"
zero="0"
bom="\xEF\xBB\xBF"
ctrl="\x01"
