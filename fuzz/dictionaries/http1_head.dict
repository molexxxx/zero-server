# Request-line and field-line tokens (libFuzzer dictionaries accept only \\, \" and \xHH escapes).
crlf="\x0D\x0A"
lf="\x0A"
cr="\x0D"
get="GET "
post="POST "
connect="CONNECT "
options="OPTIONS "
version="HTTP/1.1"
version10="HTTP/1.0"
host="Host: "
cl="Content-Length: "
te="Transfer-Encoding: "
chunked="chunked"
conn="Connection: "
close="close"
expect="Expect: 100-continue"
upgrade="Upgrade: "
scheme="http://"
star="*"
colon=":"
tab="\x09"
nul="\x00"
