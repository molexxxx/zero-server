# HTTP/3 frame types, lengths and payloads; the first input octet picks the
# stream and role (libFuzzer dictionaries accept only \\, \" and \xHH escapes).
data="\x00"
headers="\x01"
cancel_push="\x03"
settings="\x04"
push_promise="\x05"
goaway="\x07"
max_push_id="\x0d"
h2_priority="\x02"
h2_ping="\x06"
h2_window_update="\x08"
h2_continuation="\x09"
grease="\x21"
grease_two="\x40\x40"
type_4000="\x40\x00"
priority_update="\x80\x0f\x07\x00"
len_max="\xff\xff\xff\xff\xff\xff\xff\xff"
server_settings="\x04\x09\x01\x00\x06\x80\x00\x80\x00\x07\x00"
size_32768="\x80\x00\x80\x00"
goaway_graceful="\xff\xff\xff\xff\xff\xff\xff\xfc"
qpack_prefix="\x00\x00"
