# Media type and Accept syntax (libFuzzer dictionaries accept only \\, \" and
# \xHH escapes).
slash="/"
semicolon=";"
equals="="
quote="\""
backslash="\\"
comma=","
space=" "
tab="\x09"
any="*/*"
text_any="text/*"
text_html="text/html"
json="application/json"
charset="charset="
utf8="utf-8"
q="q="
q_zero="q=0"
q_one="q=1.000"
q_half="q=0.5"
plus_json="+json"
plus_xml="+xml"
html_ext=".html"
js_ext=".JS"
obs_text="\x80"
