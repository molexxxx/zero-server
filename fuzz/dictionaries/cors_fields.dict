# Origins, methods and header names of the CORS protocol (libFuzzer
# dictionaries accept only \\, \" and \xHH escapes).
https="https://"
http="http://"
separator="://"
null="null"
foo="foo.invalid"
rabbit="rabbit.invalid"
port=":8443"
ipv6="[::1]"
lf="\x0a"
comma=", "
get="GET"
post="POST"
put="PUT"
wildcard="*"
csp="Content-Security-Policy"
hsts="Strict-Transport-Security"
requested_with="X-Requested-With"
query="?"
fragment="#"
userinfo="@"
percent="%"
upper_scheme="HTTPS://"
