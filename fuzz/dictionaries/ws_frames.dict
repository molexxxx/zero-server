# Frame header octets, the RFC 6455 Section 5.7 masking key and Close status
# codes (libFuzzer dictionaries accept only \\, \" and \xHH escapes).
text_masked="\x81\x85"
binary_len16="\x82\xfe"
binary_len64="\x82\xff"
continuation="\x00\x80"
final_continuation="\x80\x82"
close_masked="\x88\x82"
ping_masked="\x89\x80"
pong_masked="\x8a\x80"
rsv1="\xc1"
key="\x37\xfa\x21\x3d"
len16="\x01\x00"
len16_short="\x00\x7d"
len64="\x00\x00\x00\x00\x00\x01\x00\x00"
len64_top="\x80\x00\x00\x00\x00\x00\x00\x00"
close_1000="\x03\xe8"
close_1005="\x03\xed"
close_1006="\x03\xee"
close_1014="\x03\xf6"
close_1015="\x03\xf7"
close_3000="\x0b\xb8"
close_4999="\x13\x87"
utf8_two="\xc3\xa9"
utf8_surrogate="\xed\xa0\x80"
