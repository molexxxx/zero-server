# Masked frame headers, the RFC 6455 Section 5.7 masking key, Close status codes
# and UTF-8 edges (libFuzzer dictionaries accept only \\, \" and \xHH escapes).
text="\x81\x85"
text_first="\x01\x83"
binary="\x82\x85"
binary_len16="\x82\xfe"
binary_len64="\x82\xff"
continuation="\x00\x82"
final_continuation="\x80\x82"
close="\x88\x82"
close_empty="\x88\x80"
ping="\x89\x85"
pong="\x8a\x85"
key="\x37\xfa\x21\x3d"
zero_key="\x00\x00\x00\x00"
len16="\x04\x01"
len64="\x00\x00\x00\x00\x00\x01\x00\x00"
close_1000="\x03\xe8"
close_1005="\x03\xed"
close_3000="\x0b\xb8"
utf8_two="\xc3\xa9"
utf8_three="\xe2\x82\xac"
utf8_four="\xf0\x9f\x98\x80"
utf8_surrogate="\xed\xa0\x80"
utf8_overlong="\xc0\xaf"
