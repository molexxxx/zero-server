# Planning and structure docs (kept local, never pushed)
.docs/

# Rust
/target/
**/target/
/debug/
**/*.rs.bk
*.pdb
**/mutants.out*/

# Node
node_modules/
dist/
.npm/
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
wheels/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# .NET build output. Scoped to the .NET tree, since `bin/` on its own also hides a
# Rust package's src/bin, which is where a package's extra programs live.
bindings/dotnet/**/bin/
bindings/dotnet/**/obj/
bench/probes/dotnet/**/bin/
bench/probes/dotnet/**/obj/
*.user

# Native build artifacts
*.o
*.a
*.so
*.dylib
*.dll
*.node

# Editor / OS
.DS_Store
Thumbs.db
.idea/

# Logs and coverage
coverage/
*.log

# DocFX metadata intermediates, rebuilt by the docs workflow.
bindings/dotnet/docs/api/

# The catalog of open regressions, kept local until it is empty.
conformance/regressions.md

# Inputs libFuzzer writes into the working directory when a target fails.
/crash-*
