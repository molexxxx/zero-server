{
  "name": "@zero-server/native",
  "version": "0.1.0",
  "description": "The compiled zero-server core for Node and the generated napi-rs contract every @zero-server package builds on. Installed as a dependency, not directly.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/molexxxx/zero-core.git",
    "directory": "bindings/node/packages/native"
  },
  "homepage": "https://z-server.dev",
  "keywords": [
    "zero-server",
    "http",
    "server",
    "napi-rs"
  ],
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "napi": {
    "binaryName": "zero-server-native",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "engines": {
    "node": ">= 16"
  }
}
