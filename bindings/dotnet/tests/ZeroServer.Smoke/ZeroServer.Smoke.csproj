<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>ZeroServer.Smoke</RootNamespace>

    <!-- The native library is not copied here: the smoke loads it only through
         ZERO_SERVER_NATIVE_LIBRARY_PATH, so its first native call shows that the
         resolver is registered before an import is bound. -->
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../../'))</RepoRoot>
    <ZeroVectorsPath>$(RepoRoot)conformance/vectors.json</ZeroVectorsPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ZeroServer/ZeroServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cross-language conformance vectors, copied next to the executable so
         this runner reads the same committed file as the other bindings. -->
    <None Include="$(ZeroVectorsPath)">
      <Link>vectors.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
